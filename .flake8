# Исключаем служебные папки, окружения и кэш из проверки
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .optuna,
    optuna_studies,
    .pytest_cache,
    .github,
    build,
    dist

# Увеличиваем максимальную длину строки до 120 символов
max-line-length = 120

# Максимальная цикломатическая сложность функций
max-complexity = 10

# Игнорируем специфичные предупреждения:
# W503 — перенос строки перед бинарным оператором
# E203 — пробел перед двоеточием
ignore = W503, E203